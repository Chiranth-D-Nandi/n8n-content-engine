{
  "name": "Matiks Content Engine Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/matiks-reel",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "matiks-reel-trigger"
    },
    {
      "parameters": {
        "jsCode": "// Normalise incoming payload and apply defaults\nconst body = $input.first().json.body || $input.first().json || {};\n\nreturn [{\n  json: {\n    channel_id: body.channel_id || 'ai_tech',\n    topic_override: body.topic_override || '',\n    reel_count: Math.min(Math.max(parseInt(body.reel_count) || 1, 1), 5),\n    subtitle_style: body.subtitle_style || null\n  }\n}];"
      },
      "id": "2",
      "name": "Normalise Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/webhook/matiks-reel",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "3",
      "name": "Forward to API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "4",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Normalise Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalise Payload": {
      "main": [
        [
          {
            "node": "Forward to API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward to API": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
